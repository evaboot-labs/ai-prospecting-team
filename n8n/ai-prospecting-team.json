        "truncateResponse": true,
        "maxLength": 12000
      },
      "id": "82dacff1-e25d-43c1-98e1-3b2c46416ac4",
      "name": "Fetch page",
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.2,
      "position": [
        1020,
        220
      ]
    },
    {
      "parameters": {
        "toolDescription": "Search recent news about a company. Give a query such as \"Acme Ltd\". Returns dated headlines with links.",
        "url": "=https://news.google.com/rss/search?q={{ encodeURIComponent($fromAI('query', 'The company name in quotes', 'string')) }}&hl=en-GB&gl=GB&ceid=GB:en",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          },
          "timeout": 20000
        },
        "optimizeResponse": true,
        "responseType": "text",
        "truncateResponse": true,
        "maxLength": 8000
      },
      "id": "b9d8a3c4-737d-4fb8-81bb-102a91078972",
      "name": "Search news",
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.2,
      "position": [
        1140,
        220
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ JSON.stringify({ lead: $('Keep matching leads').item.json, research: $json.output }) }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "=You are the qualifier of a prospecting team. You judge. Use only the lead and research JSON.\nScore 0 to 100: role 40 (the title is a buyer named in the brief), company 30 (industry, headcount and region match),\ntiming 20 (a dated, sourced fact gives a reason to talk now), tenure 10 (3 to 24 months in the role).\nA missing field scores 0, never a guess. Then apply the brief's disqualifiers, and only those: any match sets keep to false.\nKeep when the score is 60 or more and no disqualifier applies. The reason names the fields and facts used.\nopener_fact is the research fact the writer should use (empty if none); opener_source is its URL.\n\nBrief:\n{{ $('Your settings').first().json.brief }}",
          "maxIterations": 12
        }
      },
      "id": "f08330b1-9713-412e-84a3-acb2ac440fae",
      "name": "Qualifier",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2.2,
      "position": [
        1300,
        0
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "claude-sonnet-5-5",
          "cachedResultName": "claude-sonnet-5-5"
        },
        "options": {
          "maxTokensToSample": 4000
        }
      },
      "id": "ef9fae8c-05e3-4b3f-b771-0362e9e06296",
      "name": "Claude (qualifier)",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [
        1260,
        220
      ],
      "credentials": {
        "anthropicApi": {
          "id": "",
          "name": "Anthropic"
        }
      }
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"required\": [\n    \"score\",\n    \"keep\",\n    \"reason\",\n    \"opener_fact\",\n    \"opener_source\"\n  ],\n  \"properties\": {\n    \"score\": {\n      \"type\": \"number\"\n    },\n    \"keep\": {\n      \"type\": \"boolean\"\n    },\n    \"reason\": {\n      \"type\": \"string\"\n    },\n    \"opener_fact\": {\n      \"type\": \"string\"\n    },\n    \"opener_source\": {\n      \"type\": \"string\"\n    }\n  }\n}"
      },
      "id": "49341c27-32ee-49ec-b74b-06e37f9018db",
      "name": "Qualifier output",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1420,
        220
      ]
    },
    {
      "parameters": {
        "jsCode": "\n// Qualifier rule: one lead per company, the highest score wins. Then keep score >= 60 and no disqualifier.\n// Each row is joined to the lead it came from (paired items), never by position.\nconst rows = $input.all().map((it, i) => ({\n  ...$('Keep matching leads').itemMatching(i).json,\n  research: $('Researcher').itemMatching(i).json.output,\n  ...it.json.output,\n}));\nconst best = {};\nfor (const r of rows) if (r.keep && (!best[r.company] || r.score > best[r.company].score)) best[r.company] = r;\nreturn Object.values(best).map(r => ({ json: r }));\n"
      },
      "id": "d79a242f-f052-4059-98cc-2c2a9897a702",
      "name": "One lead per company",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ JSON.stringify($json) }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "=You are the writer of a prospecting team. Write one first email from the brief and the opener fact. Never send.\nSubject: 2 to 5 words, lower case. Line 1: the opener fact, said plainly. Line 2: why it matters to this role.\nLine 3: the offer in one sentence, naming the product, with the proof from the brief. Line 4: one low-effort question.\nUnder 100 words, no links, blank line between paragraphs, signed with the sender name from the brief.\nNever invent a fact, a number or a name. If opener_fact is empty, open on the role and company instead.\n\nBrief:\n{{ $('Your settings').first().json.brief }}",
          "maxIterations": 12
        }
      },
      "id": "1951908e-c220-4439-92b7-efa8d3558278",
      "name": "Writer",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2.2,
      "position": [
        1800,
        0
      ],
