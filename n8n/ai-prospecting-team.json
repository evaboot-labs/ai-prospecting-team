      "id": "9e1b9066-6149-491b-bf29-4a4a6eee825c",
      "name": "Your settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "endpointUrl": "https://mcp.evaboot.com/mcp",
        "authentication": "bearerAuth",
        "tool": {
          "__rl": true,
          "mode": "list",
          "value": "get_export",
          "cachedResultName": "get_export"
        },
        "inputMode": "json",
        "jsonInput": "={{ JSON.stringify({ extraction_id: $('Your settings').first().json.export_id }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "183e0833-c1b3-4e17-bd2e-143e00c38622",
      "name": "List builder",
      "type": "@n8n/n8n-nodes-langchain.mcpClient",
      "typeVersion": 1.1,
      "position": [
        440,
        0
      ],
      "credentials": {
        "httpBearerAuth": {
          "id": "",
          "name": "Evaboot MCP (Bearer)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "\n// List builder: keep leads that match your filters with a safe email. Time in role = years + months.\nconst num = v => { const n = parseFloat(String(v ?? '').replace(/,/g, '')); return isNaN(n) ? null : n; };\nconst all = $json.structuredContent?.result?.prospects || [];\nconst kept = all.filter(p => p['Matches Filters'] === 'YES' && p['Email Status'] === 'safe');\nreturn kept.map((p, i) => ({ json: {\n  id: `lead-${String(i + 1).padStart(2, '0')}`,\n  first_name: p['First Name'] || '', last_name: p['Last Name'] || '', email: p['Email'],\n  title: String(p['Current Job'] || '').trim(), linkedin_url: p['Linkedin URL Public'] || '',\n  months_in_role: (num(p['Years in Position']) || 0) * 12 + (num(p['Months in Position']) || 0),\n  company: p['Company Name'] || '', company_domain: p['Company Domain'] || '',\n  company_website: p['Company Website'] || '', company_headcount: num(p['Company Employee Exact Count']),\n  company_industry: p['Company Industry'] || '', company_hq: p['Company Headquarters (Full Address)'] || '',\n} }));\n"
      },
      "id": "a8115f91-56bb-46a8-93f2-8504ef81e092",
      "name": "Keep matching leads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ JSON.stringify($json) }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are the researcher of a prospecting team. You find facts. You do not judge fit and you do not write emails.\nFor the company in the lead JSON: first call Search news with the company name in quotes; its results are dated headlines with links.\nThen open the company website, or a news link, with Fetch page to confirm a fact (at most 6 calls in total).\nKeep at most two facts from the last 12 months, newest first. A fact is something that happened, with the date the page shows and its URL.\n\"Opened 3 SDR roles, posted 2026-10-14\" is a fact. \"Growing fast\" is not. Never guess a date. If nothing is found, set no_fact_found to true.\nAlso say in one line what the company sells, from its own site.",
          "maxIterations": 12
        }
      },
      "id": "a06713ff-dad1-453a-a667-f293a2e9ef09",
      "name": "Researcher",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2.2,
      "position": [
        900,
        0
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "claude-sonnet-5-5",
          "cachedResultName": "claude-sonnet-5-5"
        },
        "options": {
          "maxTokensToSample": 4000
        }
      },
      "id": "1e16d9be-ee6a-4ea9-b0ee-00d4b55a5480",
      "name": "Claude (researcher)",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [
        860,
        220
      ],
      "credentials": {
        "anthropicApi": {
          "id": "",
          "name": "Anthropic"
        }
      }
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"required\": [\n    \"what_they_sell\",\n    \"facts\",\n    \"no_fact_found\"\n  ],\n  \"properties\": {\n    \"what_they_sell\": {\n      \"type\": \"string\"\n    },\n    \"no_fact_found\": {\n      \"type\": \"boolean\"\n    },\n    \"facts\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"required\": [\n          \"fact\",\n          \"source\",\n          \"date\"\n        ],\n        \"properties\": {\n          \"fact\": {\n            \"type\": \"string\"\n          },\n          \"source\": {\n            \"type\": \"string\"\n          },\n          \"date\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    }\n  }\n}"
      },
      "id": "e2fbce42-5f87-4c79-b1e8-7e41096d9358",
      "name": "Researcher output",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1020,
        220
      ]
    },
    {
      "parameters": {
        "toolDescription": "Open a web page and return its text. Give the full URL.",
        "url": "={{ $fromAI('url', 'The full URL of the page to open', 'string') }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          },
          "timeout": 20000
        },
        "optimizeResponse": true,
        "responseType": "html",
